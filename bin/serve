#!/bin/sh
# Preview the site at http://localhost:4000/ezxmldsig-doc/, rebuilt on every
# change, with the gems of GitHub Pages (see Gemfile), in Docker: nothing to
# install but a running Docker daemon. The gems are kept in a volume between
# runs.
set -e
cd "$(dirname "$0")/.."
# A terminal for Ctrl-C, when there is one.
tty=; [ -t 0 ] && tty=-it
# A previous preview whose script was stopped without a terminal may still
# run: it holds the port.
docker rm -f ezxmldsig-doc-serve >/dev/null 2>&1 || true
exec docker run --rm $tty --name ezxmldsig-doc-serve \
  -p 127.0.0.1:4000:4000 \
  -v "$PWD":/site -w /site \
  -v ezxmldsig-doc-gems:/usr/local/bundle \
  ruby:3.3 \
  sh -c 'bundle install --quiet && bundle exec jekyll serve --host 0.0.0.0 --force_polling'
